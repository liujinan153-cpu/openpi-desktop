{
  "name": "openpi-desktop",
  "version": "0.65.1",
  "private": true,
  "type": "module",
  "description": "OpenPi Desktop - desktop agent harness powered by pi coding agent SDK",
  "author": "OpenPi Desktop contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/liujinan153-cpu/openpi-desktop.git"
  },
  "homepage": "https://github.com/liujinan153-cpu/openpi-desktop",
  "bugs": "https://github.com/liujinan153-cpu/openpi-desktop/issues",
  "main": "src/main/main.mjs",
  "scripts": {
    "poc": "node scripts/poc-node.mjs",
    "start": "electron .",
    "check": "node scripts/verify-check.cjs",
    "test:unit": "node scripts/unit-p53.cjs && node scripts/unit-p55.cjs && node scripts/unit-p64b.mjs && node scripts/unit-p69.mjs && node scripts/unit-p70.mjs && node scripts/unit-p71.mjs",
    "test:ci": "npm run check && npm run test:unit",
    "e2e:all": "node scripts/e2e-all.mjs",
    "e2e:mock": "node scripts/e2e-all.mjs --mock-only",
    "dist": "node scripts/dist.mjs",
    "dist:skip-e2e": "electron-builder --win",
    "smoke:package": "node scripts/smoke-package.mjs",
    "licenses:audit": "node scripts/audit-licenses.mjs",
    "publish:github": "node scripts/publish-github.mjs liujinan153-cpu/openpi-desktop"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "chrome-remote-interface": "^0.34.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "lucide": "^1.46.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "typebox": "^1.3.7",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "build": {
    "appId": "dev.openpi.desktop",
    "productName": "OpenPi Desktop",
    "afterPack": "scripts/after-pack.cjs",
    "publish": {
      "provider": "github",
      "owner": "liujinan153-cpu",
      "repo": "openpi-desktop"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json",
      "resources/**/*",
      "!resources/runtime/**"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/main/computer-daemon.ps1",
        "to": "computer-daemon.ps1"
      },
      {
        "from": "src/main/computer-ops.ps1",
        "to": "computer-ops.ps1"
      },
      {
        "from": "resources/bin/ast-grep.exe",
        "to": "ast-grep.exe"
      }
    ],
    "asarUnpack": [
      "vendor/**/*",
      "resources/skills/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
